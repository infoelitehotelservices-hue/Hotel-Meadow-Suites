# Server Configuration
PORT=6013
NODE_ENV=production

# Database
MONGOURL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Secret (Use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this
SECRET=your-encryption-secret-change-this

# Email Configuration
AUTH_EMAIL=your-email@gmail.com
AUTH_PASSWORD=your-app-specific-password

# Frontend URL (Update with your production domain)
FRONTEND_URL=https://your-frontend-domain.com
